# ── Required ────────────────────────────────────────────────────────────────
# Telegram bot token from @BotFather. Each machine needs its OWN bot/token —
# two processes long-polling the same token will steal updates from each other.
TELEGRAM_BOT_TOKEN=

# Absolute path for per-account screenshots.
# REQUIRED on the Telegram-bot path: src/server/bookingEngine.ts falls back to
# the Docker path '/app/screenshots' when this is unset, which does not exist on
# macOS — screenshots then fail silently. Point it at <repo>/screenshots.
SCREENSHOTS_DIR=/ABSOLUTE/PATH/TO/automation-qa-suth/screenshots

# ── Timezone ────────────────────────────────────────────────────────────────
# Not read by the code — the scheduler uses local `Date`. Set it here (and in
# the launchd plist) so the process's local noon IS Thai noon.
TZ=Asia/Bangkok

# ── Optional ────────────────────────────────────────────────────────────────
# Deep prewarm at T-5min. Enabled only when the value is exactly "1"
# (src/server/bot.ts). Anything else, including "true", disables it.
DEEP_PREWARM=1

# How many seconds before the slot to start prewarming contexts.
# Default 300 when unset (src/server/bookingEngine.ts).
PREWARM_LEAD_SEC=300

# Where the bot writes its log. Defaults to <repo>/bot.log when unset
# (src/server/bot.ts). The file is truncated on every bot start.
# BOT_LOG_PATH=

# NOTE: REPORTS_DIR is NOT read anywhere — src/runner.ts hardcodes <repo>/reports.
# Setting it has no effect; kept only so older .env files stay recognizable.
