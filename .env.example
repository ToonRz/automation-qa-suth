# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Timezone for cron. Set to Asia/Bangkok so the noon trigger fires at Thai noon.
TZ=Asia/Bangkok

# Optional: where to save screenshots from the bot's runs
SCREENSHOTS_DIR=/app/screenshots

# Optional: where to write run reports
REPORTS_DIR=/app/reports

# Prewarm kill-switch. Unset or 1 = prewarmed batch at 11:55 (page-ready /
# login-ready per account). 0 = skip prewarm entirely and run full logins at
# 12:00 (the always-safe fallback).
DEEP_PREWARM=1

# How the booking POST is fired at the tick.
#   fetch (default) — serialize the real form and POST via fetch() in the page
#                     (~50ms to the wire; page never navigates).
#   click           — real submit-button click (the rollback path).
SUBMIT_VIA=fetch

# Seconds before the target tick that the prewarm starts (default 300 = 11:55).
# PREWARM_LEAD_SEC=300

# Prewarm lead used by `npm run rehearse` (default 60).
# REHEARSE_LEAD_SEC=60

# Post-noon wipe guard (requirements §10.10). The site deletes every booking
# made before ~12:00:02; the guard watches reservations.php after the tick,
# re-books accounts whose row vanished, and reports PASS only for rows still
# listed at the end of the hold window. 0 = off (pre-2026-10-01 behavior).
# WIPE_GUARD=1

# Hold window after the tick, in seconds (default 10).
# WIPE_HOLD_SEC=10
